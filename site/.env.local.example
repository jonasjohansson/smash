# Copy to `.env.local` and fill in. Nothing else needs to change in the code —
# with these unset, the site serves local seed content from content/seed.ts.

# --- Sanity (public: shipped to the browser, safe to expose) ----------------
# From https://sanity.io/manage → your project → Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Pin this. Bumping it opts into GROQ/API behaviour changes.
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-07

# --- Sanity write token (server only: NEVER prefix with NEXT_PUBLIC_) -------
# Only needed to run `npm run seed`. Create at
# https://sanity.io/manage → API → Tokens, with the "Editor" role.
SANITY_API_WRITE_TOKEN=
