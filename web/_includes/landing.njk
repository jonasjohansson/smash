---
layout: base.njk
---
{# Every image of every project, shuffled and cut fast behind the mark.
   The frame list is built in eleventy.config.js (async shortcodes lose
   arguments inside layouts). Scrolling dives into the mark, the length of
   the track, and on into the project it lands on and every one after it
   (main.js); v2's glass does not. #}
<a class="stage"{% if renderer %} data-renderer="{{ renderer }}"{% endif %} href="/work/{{ poster.slug }}/" data-stage aria-label="SMASH — see the work">
  <div class="slide">
    <img src="{{ poster.src }}" alt="" fetchpriority="high" data-frame>
  </div>
  {% if not renderer %}<p class="hero-title" data-title aria-hidden="true"></p>{% endif %}
</a>
{% if not renderer %}
{# At rest the landing says who SMASH is, in a row along the top and one
   along the bottom (what was the studio page). Both go as the dive starts. #}
<header class="landing-top grid">
  <p class="lt-line">We turn spaces into experiences people remember</p>
  <a class="lt-contact" href="mailto:hello@smash.studio">Contact</a>
</header>
<footer class="landing-foot grid">
  <p class="lf-who">Experience design studio, Stockholm</p>
  <p class="lf-names">Ashley Reed, Veronica Reed, Emile Pascoe</p>
  <a class="lf-mail" href="mailto:hello@smash.studio">hello@smash.studio</a>
</footer>
<div class="dive-track" data-track></div>
<div class="dive-project" data-project></div>
{% include "titles.njk" %}
{% endif %}
<script type="application/json" id="frames">{{ frames | dump | safe }}</script>
