<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0b0b0c">
  <title>{% if title %}{{ title }} · {% endif %}SMASH</title>
  {% set about = description or 'SMASH is an experience design studio in Stockholm. We make interactive installations, projection mapping and immersive environments, from the first idea to the last night of the run.' %}
  <meta name="description" content="{{ about }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="SMASH">
  <meta property="og:title" content="{% if title %}{{ title }} · {% endif %}SMASH">
  <meta property="og:description" content="{{ about }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or poster.og }}">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/brand/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="icon" href="/brand/favicon.svg" type="image/svg+xml">
  <script>document.documentElement.classList.add('js');</script>
  <link rel="preload" href="/next/assets/fonts/nhg-display/NHaasGroteskDSPro-55Rg.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/next/assets/fonts/nhg-text/NHaasGroteskTXPro-55Rg.woff2" as="font" type="font/woff2" crossorigin>
  {% if preloadImage %}<link rel="preload" href="{{ preloadImage }}" as="image" fetchpriority="high">{% endif %}
  <link rel="stylesheet" href="/next/assets/next.css?v={{ build }}">
  {#- work/project pages: extra stylesheets from front matter `styles: [file.css]` (in /next/assets/) -#}
  {% for c in styles %}<link rel="stylesheet" href="/next/assets/{{ c }}?v={{ build }}">{% endfor %}
  <script type="module" src="/next/assets/js/site.js?v={{ build }}"></script>
  {% for s in scripts %}<script type="module" src="/next/assets/js/{{ s }}?v={{ build }}"></script>{% endfor %}
</head>
<body class="{{ bodyClass }}{% if ground == 'paper' %} on-paper{% endif %}"{% if ground == 'paper' %} data-ground="paper"{% endif %}>
  <a class="skip" href="#content">Skip to content</a>

  <header class="site-header grid t-meta" data-header>
    {% set markId = 'm-head' %}{% set markLabel = 'SMASH, home' %}{% set markClass = '' %}
    <a class="home-link" href="/next/" aria-label="SMASH, home">{% include "next/mark.njk" %}</a>
    <p class="tagline" data-tagline><span data-tagline-text>Experience design studio, Stockholm</span><span class="running tnum" data-running></span></p>
    <nav class="nav" aria-label="Main">
      <a href="/next/work/"{% if section == 'work' %} aria-current="page"{% endif %}>Work</a>
      <a href="/next/studio/"{% if section == 'studio' %} aria-current="page"{% endif %}>Studio</a>
      <a href="#contact">Contact</a>
    </nav>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="sheet" data-menu>Menu</button>
  </header>

  <div class="sheet" id="sheet" hidden data-sheet>
    <div class="sheet-top t-meta">
      {% set markId = 'm-sheet' %}{% set markLabel = 'SMASH, home' %}
      <a href="/next/" aria-label="SMASH, home">{% include "next/mark.njk" %}</a>
      <button class="sheet-close" type="button" data-menu-close>Close</button>
    </div>
    <nav aria-label="Main, on a phone">
      <a class="t-h1" href="/next/work/">Work</a>
      <a class="t-h1" href="/next/studio/">Studio</a>
      <a class="t-h1" href="#contact" data-menu-close>Contact</a>
    </nav>
    <div class="sheet-foot">
      <a class="t-body" href="mailto:hello@smash.studio">hello@smash.studio</a>
      <p class="t-meta dim">Stockholm <span class="tnum" data-clock>--:--</span></p>
    </div>
  </div>

  <main id="content" tabindex="-1">
{{ content | safe }}
  </main>

  {% if not noContact %}{% include "next/contact.njk" %}{% endif %}

  <div class="grid-overlay grid" hidden aria-hidden="true" data-grid-overlay>
    {% for i in range(0, 11) %}<span></span>{% endfor %}
    <p class="measures t-meta">Bar 32 · slot 20 · pitch 52 · 11 columns, 10 gutters, 8 : 5</p>
  </div>
</body>
</html>
