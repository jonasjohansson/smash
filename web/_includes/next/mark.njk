{#- The original SMASH mark (mark.js at its defaults, in its own units): the
    block in currentColor, the slots cut through it. Set `markId` before the
    include so each copy on a page has its own mask. `.mark-door` is the live
    mark's one variation: the A's window running out through the top edge. -#}
{%- set mid = markId or 'mark' -%}
<svg class="mark{% if markClass %} {{ markClass }}{% endif %}" viewBox="0 0 552 472" {% if markLabel %}role="img" aria-label="{{ markLabel }}"{% else %}aria-hidden="true" focusable="false"{% endif %}><defs><mask id="{{ mid }}" maskUnits="userSpaceOnUse" x="-1" y="-1" width="554" height="474"><rect x="-1" y="-1" width="554" height="474" fill="#fff"/><g fill="#000" stroke="#000"><path fill="none" stroke-width="20" stroke-linejoin="round" d="M42 42L42 200A10 10 0 0 0 52 210L94 210M-62 262L32 262A10 10 0 0 1 42 272L42 430M94 -236L94 708M146 42L146 708M198 42L198 708M250 -236L250 708M302 42L302 220M302 252L302 708M354 -236L354 708M406 42L406 200A10 10 0 0 0 416 210L458 210M354 262L396 262A10 10 0 0 1 406 272L406 430M458 -236L458 708M510 -236L510 220M510 252L510 708"/><g stroke="none"><circle cx="42" cy="42" r="10"/><circle cx="42" cy="430" r="10"/><circle cx="146" cy="42" r="10"/><circle cx="198" cy="42" r="10"/><circle cx="302" cy="42" r="10"/><circle cx="406" cy="42" r="10"/><circle cx="406" cy="430" r="10"/><rect class="mark-door" x="292" y="-2" width="20" height="44"/></g></g></mask></defs><rect width="552" height="472" fill="currentColor" mask="url(#{{ mid }})"/></svg>
