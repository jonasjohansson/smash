disablesAutomaticAlignment = 1;
familyName = SMASH;
featurePrefixes = (
{
code = "lookup L_STEM { sub L by L.stem; } L_STEM;\012lookup ON_L { sub @FOOT by @FOOT_ONL; } ON_L;\012lookup BEFORE_T { sub @BEFORE by @BEFORE_T; } BEFORE_T;\012lookup AFTER_T { sub @AFTER by @AFTER_T; } AFTER_T;\012lookup BETWEEN_T { sub @BETWEEN by @BETWEEN_T; } BETWEEN_T;\012";
name = "<anonymous>";
}
);
features = (
{
code = "sub Y by Y.ss01; sub R by R.ss01; sub K by K.ss01; sub V by V.ss01; sub X by X.ss01; ";
name = ss01;
},
{
code = "# An L and the letter after it: the L's stem, the letter on its foot.\012    lookup L_FEET {\012        sub L' lookup L_STEM @FOOT' lookup ON_L;\012    } L_FEET;\012    # The letters either side of a T, under its arm.\012    lookup T_ARMS {\012        sub T @BETWEEN' lookup BETWEEN_T T;\012        sub @BEFORE' lookup BEFORE_T T;\012        sub T @AFTER' lookup AFTER_T;\012    } T_ARMS;\012    # The T itself: only its stem, or its stem and the reach of its arm on\012    # the side with no letter under it.\012    lookup T_STEMS {\012        sub @ARM_LEFT T' @ARM_RIGHT by T.both;\012        sub @ARM_LEFT T' by T.left;\012        sub T' @ARM_RIGHT by T.right;\012    } T_STEMS;";
name = calt;
}
);
