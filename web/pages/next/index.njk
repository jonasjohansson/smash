---
permalink: /next/
bodyClass: home
preloadImage: /next/assets/img/reel-poster.webp
scripts:
  - aperture.js
---
{# Async shortcodes ({% image %}, {% imageSrc %}) render nothing inside
   {% include %} or macros, so media markup is written inline in loops. #}

{#- The opening: the mark, whole, with the showreel playing through its
    slots. Scrolled, the slots open into the film (aperture.js). -#}
<section class="aperture" aria-label="Showreel" data-aperture>
  <div class="ap-stage" data-ap-stage>
    <video class="ap-film" muted loop playsinline preload="auto" poster="/next/assets/img/reel-poster.webp" aria-hidden="true" data-auto data-ap-film>
      <source src="/reel/showreel-landing-av1.mp4" type='video/mp4; codecs="av01.0.08M.10"'>
      <source src="/reel/showreel-landing.mp4" type="video/mp4">
    </video>
    <canvas class="ap-ink" aria-hidden="true" data-ap-ink></canvas>
    <div class="ap-static" aria-hidden="true">
      <img class="ap-poster" src="/next/assets/img/reel-poster.webp" alt="" fetchpriority="high">
      {% set markId = 'm-aperture' %}{% set markLabel = '' %}{% include "next/mark.njk" %}
    </div>
    <div class="ap-row grid" data-ap-row>
      <p class="c-all"><button type="button" data-reel-open>Watch with sound</button></p>
    </div>
  </div>
</section>

<section class="statement grid" aria-labelledby="statement-title">
  <h1 class="c-1-9 t-large" id="statement-title">We turn facades, domes and city squares into places people step into, play with and remember.</h1>
</section>

{#- The work, newest first: a room for each project, full bleed, people inside
    the work, and its name under it at column 1. One picture each, and none of
    them stands for the project anywhere else on the site (next.11tydata.js, HOME). -#}
<section class="passes" aria-label="Work">
{%- for w in work %}{% set m = w.home %}
  <a class="pass" href="{{ w.url }}" aria-labelledby="pt-{{ w.slug }}">
    <div class="room">
      <div class="media" style="--ar: {{ m.ar }}{% if m.focus %}; --focus: {{ m.focus }}{% endif %}">
        {% image m.src, m.alt, "100vw", "lazy" %}
      </div>
    </div>
    <div class="grid">
      <h2 class="c-all caption t-body" id="pt-{{ w.slug }}">{{ w.title }}</h2>
    </div>
  </a>
{%- endfor %}
</section>
