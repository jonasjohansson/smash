---
permalink: /next/
bodyClass: home
preloadImage: /next/assets/img/reel-poster.webp
scripts:
  - aperture.js
  - offerings.js
---
{# NOTE for anyone extending this: async shortcodes ({% image %}, {% imageSrc %})
   render nothing inside {% include %} or macros, so media markup is written
   inline in loops, as below. #}
{% set offerLine = {
  'experience-design': 'Museums and exhibitions that visitors take part in, not just look at.',
  'digital-interactive': 'Installations that answer whoever steps up.',
  'originals': 'Facades and stages, drawn to a building’s own lines.'
} %}

{#- 1. Aperture. The original mark across the full grid: its ten slots are the
    page's ten gutters. The showreel plays only inside them, light through
    slits in a dark room. Scrolled, the doors open through the edges, then the
    slots widen into the whole film (aperture.js). -#}
<section class="aperture" aria-label="Showreel" data-aperture>
  <div class="ap-stage" data-ap-stage>
    <video class="ap-film" muted loop playsinline preload="auto" poster="/next/assets/img/reel-poster.webp" aria-hidden="true" data-auto data-ap-film>
      <source src="/reel/showreel-landing-av1.mp4" type='video/mp4; codecs="av01.0.08M.10"'>
      <source src="/reel/showreel-landing.mp4" type="video/mp4">
    </video>
    <canvas class="ap-ink" aria-hidden="true" data-ap-ink></canvas>
    <div class="ap-static" aria-hidden="true">
      <img class="ap-poster" src="/next/assets/img/reel-poster.webp" alt="" fetchpriority="high">
      {% set markId = 'm-aperture' %}{% set markLabel = '' %}{% include "next/mark.njk" %}
    </div>
    <p class="ap-intro t-h2" data-ap-intro>Experience design studio, Stockholm</p>
    <div class="ap-row grid baseline t-meta" data-ap-row>
      <p class="x-1-3 ap-name">Showreel 2026</p>
      <p class="x-4-8 dim ap-what">Interactive installations, projection mapping, immersive environments</p>
      <p class="x-9-11 right ap-watch"><button type="button" data-reel-open>Watch with sound</button><span class="dur tnum">0:48</span></p>
    </div>
  </div>
</section>

{#- 2. Statement -#}
<section class="section statement grid baseline" id="statement" aria-labelledby="statement-title">
  <p class="x-1 label t-meta">Studio</p>
  <h1 class="x-2-11 t-h1" id="statement-title">We turn facades, domes and city squares into places people step into, play with and remember.</h1>
  <div class="x-4-9 statement-body">
    <p class="t-body dim measure">SMASH is an experience design studio in Stockholm. We make interactive installations, projection mapping and immersive environments, and we take each one from the first idea to the last night of the run.</p>
    <p class="links t-body"><a href="/next/studio/">About the studio</a><a href="mailto:hello@smash.studio">hello@smash.studio</a></p>
  </div>
</section>

{#- 3. Selected work: one plate per project, newest first. Slots join (a
    project's pictures a gutter apart); bars separate (projects far apart). -#}
<section class="section work" id="work" aria-labelledby="work-title">
  <div class="grid section-head t-meta">
    <h2 class="x-1-5 label" id="work-title">Selected work</h2>
    <p class="x-9-11 right"><a class="link" href="/next/work/">All work <span class="tnum">({{ work.length }})</span></a></p>
  </div>

  <div class="plates">
  {%- for w in work %}
    {%- set kind = w.plate.kind %}
    {%- set n = w.plate.items.length %}
    {%- set side = kind == 'right' or kind == 'left' %}
    <a class="plate plate-{{ kind }}" href="{{ w.url }}" style="--project: {{ w.color or '#5d6268' }}" aria-labelledby="pt-{{ w.slug }}">
      {%- if not side %}
      <div class="grid plate-index">
        <span class="x-1 no t-meta tnum">{{ w.number }}</span>
        <h3 class="x-2-9 t-h1 plate-title" id="pt-{{ w.slug }}">{{ w.title }}</h3>
        <p class="x-10-11 right plate-facts t-meta">{{ w.offering }}<br><span class="tnum">{{ w.year }}</span></p>
      </div>
      {%- endif %}

      {%- if kind == 'room' %}<div class="room">
      {%- elif kind == 'plate' %}<div class="grid"><div class="x-all">
      {%- elif kind == 'row' %}<div class="grid"><div class="x-all row row-{{ n }}">
      {%- else %}<div class="grid side">
        <div class="{{ 'x-1-3' if kind == 'right' else 'x-9-11' }} side-text" style="grid-row: 1">
          <span class="no t-meta tnum dim">{{ w.number }}</span>
          <h3 class="t-h2 plate-title" id="pt-{{ w.slug }}">{{ w.title }}</h3>
          <p class="t-body dim">{{ w.lead }}</p>
          <div class="side-foot t-meta">
            <p>{{ w.place }}</p>
            <p class="dim">{{ w.offering }}, <span class="tnum">{{ w.year }}</span></p>
          </div>
        </div>
        <div class="{{ 'x-4-11' if kind == 'right' else 'x-1-8' }}" style="grid-row: 1">
      {%- endif %}

      {%- for m in w.plate.items %}
        {%- set sz = '100vw' if kind == 'room' else ('(max-width: 719px) 100vw, 72vw' if side else ('(max-width: 719px) 100vw, ' + ((m.share * 94) | round) + 'vw' if kind == 'row' else '(max-width: 719px) 100vw, 94vw')) %}
        <div class="media{% if loop.first %} reveal{% endif %}{% if kind != 'row' %} bleed-phone{% endif %}" style="--ar: {{ m.ar }}{% if loop.first %}; view-transition-name: room-{{ w.slug }}{% endif %}">
          {%- if m.type == 'video' %}
          <video muted loop playsinline preload="none" poster="{% imageSrc m.poster, 2000, 'webp' %}" aria-label="{{ m.alt }}" data-auto><source src="{{ m.src }}" type="video/{{ 'webm' if m.src.endsWith('.webm') else 'mp4' }}"></video>
          {%- else %}
          {% image m.src, m.alt, sz, "lazy" %}
          {%- endif %}
        </div>
      {%- endfor %}

      {%- if kind == 'room' %}</div>
      {%- elif side %}</div></div>
      {%- else %}</div></div>
      {%- endif %}

      {%- if not side %}
      <div class="grid plate-cap">
        <p class="x-2-7 t-body lead measure">{{ w.lead }}</p>
        <p class="x-10-11 right t-meta place">{{ w.place }}</p>
      </div>
      {%- endif %}
    </a>
  {%- endfor %}
  </div>
</section>

{#- 4. What we do: the three offerings, ruled like a schedule. On a fine
    pointer, the hovered one lights its picture in the last three columns. -#}
<section class="section offerings" aria-labelledby="offer-title" data-offerings>
  <div class="grid section-head t-meta">
    <h2 class="x-1-5 label" id="offer-title">What we do</h2>
  </div>
  <div class="grid offer-wrap">
    <ul class="x-all offer-list" data-offer-list>
      {%- for c in categories %}
      <li style="display: contents"><a class="offer" href="/next/work/?in={{ c.slug }}" data-offer="{{ loop.index0 }}">
        <span class="name t-h1">{{ c.name }}<span class="count">{{ (counts[c.slug] or 0) | pad }}</span></span>
        <span class="desc t-body">{{ offerLine[c.slug] or c.label }}</span>
      </a></li>
      {%- endfor %}
    </ul>
    <div class="offer-panel" aria-hidden="true" data-offer-panel>
      {%- for c in categories %}
      <div class="media">{% image c.hero.src, '', '(min-width: 720px) 24vw, 1px', 'lazy' %}</div>
      {%- endfor %}
    </div>
  </div>
</section>

{#- 5. People -#}
<section class="section people" aria-labelledby="people-title">
  <div class="grid baseline people-intro">
    <h2 class="x-1 label t-meta" id="people-title">People</h2>
    <p class="x-4-10 t-lead">Every project has its own lead, with a senior creative and a senior technical lead beside them. We bring in makers from our network as the work needs.</p>
  </div>
  <div class="grid">
    <ul class="x-all bars bars-3">
      {%- for p in team %}
      <li><a class="person" href="mailto:{{ p.email }}">
        <div class="media">{{ p.picture | safe }}</div>
        <p class="who t-body">{{ p.name }}{% if p.role %}<span class="dim">, {{ p.role }}</span>{% endif %}</p>
        <p class="mail t-meta">{{ p.email }}</p>
      </a></li>
      {%- endfor %}
    </ul>
  </div>
  <div class="grid after-people">
    <p class="x-4-9 t-body"><a href="/next/studio/">About the studio</a></p>
  </div>
</section>

{#- 6. Worked with: a sentence, not a logo wall. -#}
<section class="section clients grid baseline" aria-labelledby="clients-title">
  <h2 class="x-1 label t-meta" id="clients-title">Worked with</h2>
  <p class="x-4-11 t-lead names">{% for c in clients %}<span>{{ c.name }}</span>{% if loop.revindex == 2 %}<span class="and"> and </span>{% elif not loop.last %}<span class="and">, </span>{% endif %}{% endfor %}<span class="and">.</span></p>
</section>
