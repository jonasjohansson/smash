---
pagination:
  data: work
  size: 1
  alias: w
permalink: "/next/work/{{ w.slug }}/"
section: work
bodyClass: project-page
styles:
  - work.css
eleventyComputed:
  title: "{{ w.title }}"
  description: "{{ stories[w.slug].lead | mdInline | striptags }}"
---
{#- A project: a film or picture across the screen, its name, its one
    sentence, then its pictures and words (story.js): plates across the 12
    columns, rows of two, and words alone at column 7. Only the hero bleeds.
    Media markup is written inline: {% image %} renders nothing inside an
    include or a macro. -#}
{%- set s = stories[w.slug] -%}
<article class="project" aria-labelledby="t-{{ s.slug }}">

  {%- set h = s.hero %}
  {%- if h %}
  <div class="pj-hero">
    <div class="media" style="--ar: {{ h.ar }};{% if h.focus %} --focus: {{ h.focus }};{% endif %}">
      {%- if h.type == 'video' %}
      <video muted loop playsinline preload="metadata" poster="{% imageSrc h.poster, 2000, 'webp' %}" aria-label="{{ h.alt }}" data-auto><source src="{{ h.src }}" type="video/{{ 'webm' if h.src.endsWith('.webm') else 'mp4' }}"></video>
      {%- else %}
      {% image h.src, h.alt, "100vw", "eager" %}
      {%- endif %}
    </div>
  </div>
  {%- endif %}

  <header class="pj-head grid">
    <h1 class="c-all t-display" id="t-{{ s.slug }}">{{ s.title }}</h1>
    <p class="c-1-9 t-large pj-lead">{{ s.lead | mdInline | safe }}</p>
  </header>

  <div class="pj-flow">
  {%- for r in s.flow %}
    {%- if r.kind == 'text' %}
    <div class="f-text grid"><div class="c-7-12 t-body prose measure">{{ r.body | md | safe }}</div></div>
    {%- else %}
    {%- set kind = r.kind %}
    <div class="f-media f-{{ kind }} grid">
      {%- if kind == 'row' %}<div class="c-all row">{% endif %}
      {%- for m in r.items %}
        {%- if kind == 'row' %}{% set sz = '(max-width: 719px) 100vw, ' + ((m.span * 94 / 12) | round) + 'vw' %}
        {%- else %}{% set sz = '(max-width: 719px) 100vw, 94vw' %}{% endif %}
      <div class="media{% if kind == 'plate' %} c-all{% endif %}{% if m.lead %} lead{% endif %}" style="--ar: {{ m.ar }}{% if m.span %}; --span: {{ m.span }}{% endif %}{% if m.focus %}; --focus: {{ m.focus }}{% endif %}{% if m.zoom %}; --zoom: {{ m.zoom }}{% endif %}">
        {%- if m.type == 'video' %}
        <video muted loop playsinline preload="none" poster="{% imageSrc m.poster, 2000, 'webp' %}" aria-label="{{ m.alt }}" data-auto><source src="{{ m.src }}" type="video/{{ 'webm' if m.src.endsWith('.webm') else 'mp4' }}"></video>
        {%- else %}
        {% image m.src, m.alt, sz, "lazy" %}
        {%- endif %}
      </div>
      {%- endfor %}
      {%- if kind == 'row' %}</div>{% endif %}
    </div>
    {%- endif %}
  {%- endfor %}
  </div>
</article>
