---
layout: base.njk
title: v3
bodyClass: maze-page
fullscreen: true
permalink: /v3/
---
{# v3: the mark as a labyrinth. Seen from above it is the landing; dive in
   and the letters are walls covered in the work, rising into the fog. #}
<canvas class="maze" data-maze aria-hidden="true"></canvas>
<p class="maze-hint" data-hint>Scroll to enter</p>
<p class="maze-title" data-title aria-live="polite"></p>
<button class="maze-up" type="button" data-up hidden>Up</button>
<nav class="projector-list" aria-label="Projects">
  {% for p in projects %}<a href="/{{ p.slug }}/">{{ p.title }}</a>{% endfor %}
</nav>
<script type="application/json" id="slides">{{ slides | dump | safe }}</script>
<script type="importmap">
{ "imports": {
  "three": "https://cdn.jsdelivr.net/npm/three@0.186.0/build/three.module.js",
  "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.186.0/examples/jsm/"
} }
</script>
<script type="module" src="/js/maze.js?v={{ build }}"></script>
