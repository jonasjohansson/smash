---
permalink: /gate/
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <script src="/js/lock.js"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>SMASH</title>
  <meta name="description" content="SMASH is a creative studio making interactive installations, projection mapping, immersive environments and digital experiences.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300&display=swap">
  <link rel="stylesheet" href="/css/main.css?v={{ build }}">
  <link rel="stylesheet" href="/gate/gate.css?v={{ build }}">
  <link rel="modulepreload" href="https://cdn.jsdelivr.net/npm/three@0.186.0/build/three.module.js">
  <script type="importmap">
  {
    "imports": {
      "three": "https://cdn.jsdelivr.net/npm/three@0.186.0/build/three.module.js",
      "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.186.0/examples/jsm/"
    }
  }
  </script>
  <script type="module" src="/gate/gate.js?v={{ build }}"></script>
</head>
<body class="gate" data-state="loading">
  <canvas class="gate-canvas" data-gate-canvas></canvas>

  <header class="site-header grid">
    <a class="logo" href="/">{% include "logo.svg" %}</a>
  </header>

  <div class="gate-ui grid">
    <button class="gate-enter" type="button" data-enter>Enter</button>
    <p class="gate-title" data-title aria-live="polite"></p>
    <p class="gate-hint" data-hint>Drag or scroll to walk</p>
  </div>

  <noscript><p class="gate-fallback"><a href="/">See the work</a></p></noscript>

  <script type="application/json" id="projects-data">[
    {%- for p in projects %}
    {"slug": "{{ p.slug }}", "title": {{ p.title | dump | safe }}, "year": {{ p.year }}, "image": "{% imageSrc p.cover.src %}"}{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]</script>
</body>
</html>
